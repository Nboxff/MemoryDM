# Model endpoint and request protocol.
# Providers: compatible, openai, openai_chat, deepseek, qwen, qwen_dashscope.
LLM_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=openai_chat
LLM_JSON_MODE=json_object
LLM_THINKING_ENABLED=false

# Embeddings use a separate endpoint and API key.
EMBEDDING_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_BATCH_SIZE=64

MEMORY_DM_DB_PATH=data/memory_dm.sqlite3
MEMORY_DM_USER_ID=local
MEMORY_DM_WRITE_EVERY=5
MEMORY_DM_MEMORY_TOP_K=10
RETRIEVAL_CONTEXT_TOKENS=16384
RETRIEVAL_MAX_ROUNDS=2
EXPERIENCE_ENABLED=true
EXPERIENCE_RETRIEVAL_ENABLED=true
PROFILE_ENABLED=true
FORGET_MAX_PASSES=2
API_TIMEOUT=120
API_MAX_RETRIES=2

# Optional Bemula judge overrides. Blank values reuse the main model settings.
BEMULA_JUDGE_URL=
BEMULA_JUDGE_API_KEY=
BEMULA_JUDGE_MODEL=
BEMULA_JUDGE_PROVIDER=
